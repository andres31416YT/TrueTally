#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

fail=0

echo "🔍 Running pre-commit checks..."
echo ""

echo "🔐 Checking for hardcoded secrets..."
if grep -rn -E "(AKIA[0-9A-Z]{16}|password\s*=\s*['\"][^'\"]{8,}|secret\s*=\s*['\"][^'\"]{8,}|api_key\s*=\s*['\"][^'\"]{8,}|BEGIN\s+(RSA\s+)?PRIVATE\s+KEY)" \
  --include="*.ts" --include="*.tsx" --include="*.js" --include="*.json" \
  --include="*.yaml" --include="*.yml" --include="*.rs" --include="*.toml" \
  --exclude-dir=node_modules --exclude-dir=.git --exclude-dir=target \
  "$REPO_ROOT" 2>/dev/null; then
  echo -e "${RED}✗ Possible hardcoded secrets detected. Remove them before committing.${NC}"
  fail=1
else
  echo -e "${GREEN}✓ No hardcoded secrets detected${NC}"
fi

echo ""
echo "📘 Checking TypeScript (frontend)..."
cd "$REPO_ROOT/app/frontend"
if npx tsc --noEmit 2>/dev/null; then
  echo -e "${GREEN}✓ TypeScript check passed${NC}"
else
  echo -e "${RED}✗ TypeScript check failed${NC}"
  fail=1
fi

echo ""
echo "🔧 Checking Ansible syntax..."
cd "$REPO_ROOT"
if ANSIBLE_ROLES_PATH=ansible/roles ANSIBLE_AWS_PROFILE="${ANSIBLE_AWS_PROFILE:-}" ansible-playbook -i ansible/inventory/hosts.ini ansible/playbooks/site.yml --syntax-check 2>/dev/null; then
  echo -e "${GREEN}✓ Ansible syntax check passed${NC}"
else
  echo -e "${RED}✗ Ansible syntax check failed${NC}"
  fail=1
fi

echo ""
echo "🏗️  Checking Terraform..."
cd "$REPO_ROOT/terraform"
if command -v terraform &> /dev/null; then
  if terraform fmt -check -recursive 2>/dev/null; then
    echo -e "${GREEN}✓ Terraform fmt check passed${NC}"
  else
    echo -e "${YELLOW}⚠ Terraform formatting issues (run 'terraform fmt -recursive')${NC}"
  fi
  if terraform validate 2>/dev/null; then
    echo -e "${GREEN}✓ Terraform validate passed${NC}"
  else
    echo -e "${YELLOW}⚠ Terraform validate failed (may need 'terraform init')${NC}"
  fi
else
  echo -e "${YELLOW}⚠ terraform not installed, skipping${NC}"
fi

echo ""
echo "🦀 Checking Rust compilation..."
cd "$REPO_ROOT/app"
if cargo check --workspace 2>/dev/null; then
  echo -e "${GREEN}✓ Rust compilation passed${NC}"
else
  echo -e "${YELLOW}⚠ Rust compilation failed (pre-existing errors or missing deps)${NC}"
  echo -e "${YELLOW}  Run 'cargo check --workspace' for details${NC}"
fi

echo ""
if [ "$fail" -eq 1 ]; then
  echo -e "${RED}─────────────────────────────────────────────${NC}"
  echo -e "${RED}Commit blocked: pre-commit checks failed.${NC}"
  echo -e "${RED}─────────────────────────────────────────────${NC}"
  exit 1
fi

echo -e "${GREEN}─────────────────────────────────────────────${NC}"
echo -e "${GREEN}All pre-commit checks passed!${NC}"
echo -e "${GREEN}─────────────────────────────────────────────${NC}"
exit 0
